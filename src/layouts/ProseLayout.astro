---
// Layout for long-form Markdown content: blog posts and project write-ups.
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';

interface Props {
    title: string;
    description: string;
    back: { href: string; label: string };
}

const { title, description, back } = Astro.props;
---

<BaseLayout title={title} description={description} type="article">
    <article class="container-page max-w-3xl pt-10 pb-20 sm:pt-16 sm:pb-28">
        <a href={back.href} class="group inline-flex items-center gap-2 text-sm text-muted transition-colors hover:text-fg">
            <Icon name="arrow-left" class="size-4 transition-transform group-hover:-translate-x-0.5" />
            {back.label}
        </a>

        <header class="mt-10 mb-12 border-b border-line pb-10">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-subtle">
                <slot name="meta" />
            </div>
            <h1 class="mt-5 text-4xl tracking-tighter sm:text-5xl">{title}</h1>
            <p class="mt-5 text-xl leading-relaxed text-muted">{description}</p>
            <slot name="header" />
        </header>

        <div class="prose">
            <slot />
        </div>

        <footer class="mt-16 border-t border-line pt-8">
            <a href={back.href} class="group inline-flex items-center gap-2 text-sm font-medium text-fg transition-colors hover:text-accent">
                <Icon name="arrow-left" class="size-4 transition-transform group-hover:-translate-x-0.5" />
                {back.label}
            </a>
        </footer>
    </article>
</BaseLayout>
