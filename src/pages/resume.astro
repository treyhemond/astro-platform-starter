---
// Web version of the résumé, generated from src/data/resume.ts.
// Print styles in globals.css turn it into a clean black-on-white document ("Save as PDF").
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { site } from '../config/site';
import { resume, formatMonth, formatRange, type Role } from '../data/resume';

const sections: { title: string; roles: Role[] }[] = [
    { title: 'Professional experience', roles: resume.experience },
    { title: 'Leadership', roles: resume.leadership }
];
const linkedinLabel = site.linkedin.replace(/^https?:\/\/(www\.)?/, '');
---

<BaseLayout title="Resume" description={`Resume of ${site.name}: ${resume.headline.join(', ')}.`}>
    <div class="container-page max-w-4xl pt-10 pb-20 sm:pt-16 sm:pb-28 print:max-w-none print:p-0">
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4 print:hidden" data-reveal>
            <p class="eyebrow">Resume</p>
            <div class="flex flex-wrap gap-3">
                <button type="button" data-print hidden class="btn btn-ghost">
                    <Icon name="printer" class="size-4" />
                    Print / Save as PDF
                </button>
                <a href="/#contact" class="btn">
                    Get in touch
                    <Icon name="arrow-right" class="size-4" />
                </a>
            </div>
        </div>

        <article class="card p-6 sm:p-12 print:border-0 print:bg-transparent print:p-0 print:backdrop-blur-none" data-reveal data-reveal-delay="80">
            <header class="border-b border-line pb-8 text-center print:pb-4">
                <h1 class="text-4xl tracking-tight sm:text-5xl print:text-3xl">{site.name}</h1>
                <p class="mt-3 text-accent">{resume.headline.join(' • ')}</p>
                <ul class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-muted">
                    <li class="flex items-center gap-1.5">
                        <Icon name="map-pin" class="size-3.5" />
                        {resume.location.city}, {resume.location.region}
                    </li>
                    <li>
                        <a href={`mailto:${site.email}`} class="flex items-center gap-1.5 transition-colors hover:text-fg">
                            <Icon name="mail" class="size-3.5" />
                            {site.email}
                        </a>
                    </li>
                    <li>
                        <a href={site.linkedin} class="flex items-center gap-1.5 transition-colors hover:text-fg" target="_blank" rel="me noopener noreferrer">
                            <Icon name="linkedin" class="size-3.5" />
                            {linkedinLabel}
                        </a>
                    </li>
                </ul>
            </header>

            <section class="resume-section">
                <h2>Professional summary</h2>
                <p class="leading-relaxed text-fg/85 print:leading-snug">{resume.summary}</p>
            </section>

            <section class="resume-section">
                <h2>Skills</h2>
                <dl class="space-y-2 text-fg/85 print:space-y-0.5">
                    {
                        resume.skills.map((skill) => (
                            <div>
                                <dt class="inline font-semibold text-fg">{skill.area}:</dt>
                                <dd class="inline"> {skill.items.join(', ')}</dd>
                            </div>
                        ))
                    }
                </dl>
            </section>

            {
                sections.map((section) => (
                    <section class="resume-section">
                        <h2>{section.title}</h2>
                        <div class="space-y-6 print:space-y-2.5">
                            {section.roles.map((item) => (
                                <div class="break-inside-avoid">
                                    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                                        <h3 class="text-base font-semibold text-fg">
                                            {item.role}
                                            <span class="font-normal text-muted">
                                                {' '}
                                                | {item.org}
                                                {item.note && ` (${item.note})`}
                                            </span>
                                        </h3>
                                        <p class="font-mono text-xs text-subtle">{formatRange(item.start, item.end)}</p>
                                    </div>
                                    <ul class="mt-2 list-disc space-y-1 pl-5 text-[0.95rem] leading-relaxed text-fg/80 marker:text-subtle print:mt-1 print:space-y-0 print:leading-snug">
                                        {item.bullets.map((bullet) => (
                                            <li>{bullet}</li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    </section>
                ))
            }

            <section class="resume-section">
                <h2>Education</h2>
                <ul class="space-y-2 print:space-y-0.5">
                    {
                        resume.education.map((item) => (
                            <li class="flex flex-wrap items-baseline justify-between gap-x-4 text-fg/85">
                                <span>
                                    <span class="font-semibold text-fg">{item.school}</span>, {item.degree}
                                </span>
                                <span class="font-mono text-xs text-subtle">{formatMonth(item.date)}</span>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section class="resume-section">
                <h2>Additional</h2>
                <ul class="list-disc space-y-1 pl-5 text-fg/85 marker:text-subtle print:space-y-0 print:leading-snug">
                    {resume.additional.map((line) => <li>{line}</li>)}
                </ul>
            </section>
        </article>
    </div>
</BaseLayout>
