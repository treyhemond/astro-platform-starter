---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import type { IconName } from '../../lib/icons';

// Add new experiments to this list as you build them.
const experiments: { title: string; description: string; href: string; icon: IconName; tags: string[] }[] = [
    {
        title: 'Blobs',
        description: 'Generate random shapes in a React island and store them in Netlify Blobs, a key/value object store.',
        href: '/lab/blobs',
        icon: 'database',
        tags: ['Storage', 'React']
    },
    {
        title: 'Edge Functions',
        description: "Code that runs at the network edge and rewrites this page based on where you're visiting from.",
        href: '/lab/edge',
        icon: 'globe',
        tags: ['Edge', 'Geolocation']
    },
    {
        title: 'Image CDN',
        description: 'On-the-fly resizing and format conversion, compared side by side with the original image.',
        href: '/lab/image-cdn',
        icon: 'image',
        tags: ['Performance', 'Images']
    },
    {
        title: 'Revalidation',
        description: 'A server-rendered page cached at the CDN for a year — and purged on demand with cache tags.',
        href: '/lab/revalidation',
        icon: 'refresh',
        tags: ['SSR', 'Caching']
    }
];
---

<BaseLayout title="Lab" description="Live experiments with Netlify platform features: Blobs, Edge Functions, Image CDN and cache revalidation.">
    <PageHeader
        eyebrow="Lab"
        title="Experiments & demos"
        description="A sandbox for server-side features. These started as Netlify's platform demos and serve as working references for adding dynamic features to the site."
    />
    <section class="container-page pb-24 sm:pb-32">
        <ul class="grid gap-5 md:grid-cols-2">
            {
                experiments.map((item, i) => (
                    <li data-reveal data-reveal-delay={String((i % 2) * 100)}>
                        <article data-spotlight class="card card-hover group flex h-full gap-5 p-6 sm:p-7">
                            <span class="grid size-12 shrink-0 place-items-center rounded-xl border border-line bg-gradient-to-br from-accent/15 to-accent-2/10 text-accent">
                                <Icon name={item.icon} />
                            </span>
                            <div class="flex-1">
                                <div class="flex items-start justify-between gap-4">
                                    <h2 class="text-xl">
                                        <a
                                            href={item.href}
                                            class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-accent"
                                        >
                                            {item.title}
                                        </a>
                                    </h2>
                                    <Icon name="arrow-up-right" class="size-5 text-subtle transition group-hover:text-accent" />
                                </div>
                                <p class="mt-2 leading-relaxed text-muted">{item.description}</p>
                                <ul class="mt-5 flex flex-wrap gap-2">
                                    {item.tags.map((tag) => (
                                        <li class="tag">{tag}</li>
                                    ))}
                                </ul>
                            </div>
                        </article>
                    </li>
                ))
            }
        </ul>
    </section>
</BaseLayout>
