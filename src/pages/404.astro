---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout title="Page not found" description="This page drifted off into the void.">
    <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
        <p class="text-gradient font-mono text-7xl font-bold tracking-tighter sm:text-8xl" data-reveal>404</p>
        <h1 class="mt-6 text-3xl sm:text-4xl" data-reveal data-reveal-delay="80">Lost in the void</h1>
        <p class="mt-4 max-w-md text-lg text-muted" data-reveal data-reveal-delay="140">
            The page you're looking for doesn't exist — or hasn't been built yet. This site is still a work in progress.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal data-reveal-delay="200">
            <a href="/" class="btn btn-lg">
                <Icon name="arrow-left" class="size-4" />
                Back home
            </a>
            <a href="/work" class="btn btn-ghost btn-lg">See my work</a>
        </div>
    </section>
</BaseLayout>
