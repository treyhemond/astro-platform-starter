---
import AfterHoursLayout from '../../layouts/AfterHoursLayout.astro';
import ProjectCard from '../../components/after-hours/ProjectCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { site } from '../../config/site';
import { getAfterHours } from '../../lib/content';

const entries = await getAfterHours();
---

<AfterHoursLayout title={site.afterHours.title} description="Fun projects and things to share with friends.">
    <header class="pb-12 sm:pb-16">
        <p class="eyebrow mb-5" data-reveal>
            <Icon name="moon" class="size-3.5" />
            Off the clock
        </p>
        <h1 class="text-5xl tracking-tighter sm:text-6xl" data-reveal data-reveal-delay="60">
            <span class="text-gradient">{site.afterHours.title}</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl" data-reveal data-reveal-delay="120">{site.afterHours.intro}</p>
    </header>

    {
        entries.length > 0 ? (
            <div class="grid gap-5 sm:grid-cols-2">
                {entries.map((entry, i) => (
                    <div data-reveal data-reveal-delay={String((i % 2) * 100)}>
                        <ProjectCard entry={entry} class="h-full" />
                    </div>
                ))}
            </div>
        ) : (
            <p class="text-muted">Nothing here yet. Check back soon.</p>
        )
    }

    <p class="mt-16 text-sm text-subtle" data-reveal>
        Looking for the professional stuff? <a href="/" class="link text-muted">Head back to the main site</a>.
    </p>
</AfterHoursLayout>
