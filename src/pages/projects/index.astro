---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
const description = 'Everything I have built, am building, or plan to build — from finished products to half-baked experiments.';
---

<BaseLayout title="Projects" description={description}>
    <PageHeader eyebrow="Projects" title="Things I've been building" description={description} />
    <section class="container-page pb-24 sm:pb-32">
        {
            projects.length > 0 ? (
                <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                    {projects.map((project, i) => (
                        <div data-reveal data-reveal-delay={String((i % 3) * 100)}>
                            <ProjectCard project={project} class="h-full" />
                        </div>
                    ))}
                </div>
            ) : (
                <p class="text-muted">Nothing here yet — check back soon.</p>
            )
        }
    </section>
</BaseLayout>
