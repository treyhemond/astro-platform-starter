---
// "Earned media" strip: outlet names as plain text (no logos, which are trademarks). Data: `resume.press`.
import { resume } from '../../data/resume';
---

<section class="container-page" aria-labelledby="press-heading">
    <div class="flex flex-col items-center gap-5 border-y border-line py-8 text-center md:flex-row md:justify-between md:text-left" data-reveal>
        <h2 id="press-heading" class="eyebrow text-subtle">Earned media coverage in</h2>
        <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-3">
            {resume.press.map((outlet) => <li class="font-serif text-xl tracking-tight text-fg/75 italic sm:text-2xl">{outlet}</li>)}
        </ul>
    </div>
</section>
