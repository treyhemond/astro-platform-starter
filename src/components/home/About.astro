---
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site';

const { title, bio, focus } = site.about;
---

<Section id="about" eyebrow="About" title={title}>
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
        <div class="space-y-5 text-lg leading-relaxed text-muted" data-reveal>
            {bio.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <ul class="grid gap-4">
            {
                focus.map((item, i) => (
                    <li data-spotlight class="card card-hover flex gap-5 p-5 sm:p-6" data-reveal data-reveal-delay={String(i * 100)}>
                        <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-gradient-to-br from-accent/15 to-accent-2/10 text-accent">
                            <Icon name={item.icon} />
                        </span>
                        <div>
                            <h3 class="text-lg">{item.title}</h3>
                            <p class="mt-1 leading-relaxed text-muted">{item.description}</p>
                        </div>
                    </li>
                ))
            }
        </ul>
    </div>
</Section>
