---
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
import { resume, formatMonth } from '../../data/resume';
---

<Section id="education" eyebrow="Education & beyond" title="Learning, leading, and logging miles">
    <div class="grid gap-5 lg:grid-cols-[1.1fr_1fr]">
        <div class="card p-6 sm:p-8" data-reveal>
            <h3 class="flex items-center gap-3 text-lg">
                <span class="grid size-9 place-items-center rounded-lg border border-line bg-white/[0.03] text-accent">
                    <Icon name="graduation-cap" class="size-4" />
                </span>
                Education
            </h3>
            <ul class="mt-4 divide-y divide-line">
                {
                    resume.education.map((item) => (
                        <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
                            <div>
                                <p class="font-medium text-white">{item.degree}</p>
                                <p class="mt-0.5 text-sm text-muted">{item.school}</p>
                            </div>
                            <time datetime={item.date} class="font-mono text-xs text-subtle">
                                {formatMonth(item.date)}
                            </time>
                        </li>
                    ))
                }
            </ul>
        </div>

        <div class="grid gap-5">
            {
                resume.beyond.map((item, i) => (
                    <div data-spotlight class="card card-hover p-6 sm:p-7" data-reveal data-reveal-delay={String((i + 1) * 100)}>
                        <h3 class="flex items-center gap-3 text-lg">
                            <span class="grid size-9 place-items-center rounded-lg border border-line bg-white/[0.03] text-accent">
                                <Icon name={item.icon} class="size-4" />
                            </span>
                            {item.title}
                        </h3>
                        <p class="mt-3 leading-relaxed text-muted">{item.text}</p>
                        <dl class="mt-5 flex flex-wrap gap-x-8 gap-y-4">
                            {item.stats.map((stat) => (
                                <div class="flex flex-col-reverse">
                                    <dt class="text-xs text-subtle">{stat.label}</dt>
                                    <dd class="text-gradient text-2xl font-semibold tracking-tight">{stat.value}</dd>
                                </div>
                            ))}
                        </dl>
                    </div>
                ))
            }
        </div>
    </div>
</Section>
