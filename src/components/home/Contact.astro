---
import Icon from '../ui/Icon.astro';
import CopyButton from '../ui/CopyButton.astro';
import { site } from '../../config/site';

const { title, body } = site.contact;
---

<section id="contact" class="container-page py-16 sm:py-24">
    <div class="relative isolate overflow-hidden rounded-3xl border border-line bg-surface px-6 py-16 text-center sm:px-14 sm:py-20" data-reveal>
        <!-- Decorative glows -->
        <div
            class="absolute -top-40 left-1/2 -z-10 size-[36rem] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,color-mix(in_oklab,var(--color-accent)_28%,transparent),transparent)]"
            aria-hidden="true"
        >
        </div>
        <div class="bg-grid absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>

        <p class="eyebrow">Contact</p>
        <h2 class="mt-5 text-4xl sm:text-5xl">{title}</h2>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted">{body}</p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
            <a href={`mailto:${site.email}`} class="btn btn-lg">
                <Icon name="mail" class="size-[1.15rem]" />
                Email me
            </a>
            <a href={site.linkedin} class="btn btn-ghost btn-lg" target="_blank" rel="me noopener noreferrer">
                <Icon name="linkedin" class="size-[1.15rem]" />
                Connect on LinkedIn
            </a>
        </div>

        <div class="mt-8 inline-flex items-center gap-2 rounded-full border border-line bg-canvas/60 py-1.5 pr-1.5 pl-4 font-mono text-sm text-muted">
            {site.email}
            <CopyButton value={site.email} label="Copy email address" />
        </div>
    </div>
</section>
