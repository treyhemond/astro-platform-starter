---
import Icon from '../ui/Icon.astro';
import StatusBadge from '../ui/StatusBadge.astro';
import type { Project } from '../../lib/content';

interface Props {
    project: Project;
    class?: string;
}

const { project, class: className } = Astro.props;
const { title, description, status, tags } = project.data;
const href = `/projects/${project.id}`;
---

<article data-spotlight class:list={['card card-hover group flex flex-col p-6 sm:p-7', className]}>
    <div class="mb-5 flex items-center justify-between gap-4">
        <StatusBadge status={status} />
        <Icon name="arrow-up-right" class="size-5 text-subtle transition duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent" />
    </div>
    <h3 class="text-xl">
        <!-- The ::after stretches the link over the whole card, so the entire card is clickable. -->
        <a href={href} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-accent">
            {title}
        </a>
    </h3>
    <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted">{description}</p>
    {
        tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <li class="tag">{tag}</li>
                ))}
            </ul>
        )
    }
</article>
