---
// Copy-to-clipboard button. Hidden until src/scripts/main.ts confirms clipboard support.
import Icon from './Icon.astro';

interface Props {
    value: string;
    label: string;
}

const { value, label } = Astro.props;
---

<button
    type="button"
    data-copy={value}
    hidden
    class="group inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs text-muted transition hover:bg-white/[0.06] hover:text-fg"
>
    <Icon name="copy" class="size-3.5 group-data-copied:hidden" />
    <Icon name="check" class="hidden size-3.5 text-emerald-400 group-data-copied:block" />
    <span data-copy-status aria-live="polite">Copy</span>
    <span class="sr-only">{label}</span>
</button>
