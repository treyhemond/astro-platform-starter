---
import { projectStatus, type Project } from '../../lib/content';

interface Props {
    status: Project['data']['status'];
    class?: string;
}

const { status, class: className } = Astro.props;
const { label, tone } = projectStatus[status];
---

<span class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset', tone, className]}>
    <span class="size-1.5 rounded-full bg-current"></span>
    {label}
</span>
