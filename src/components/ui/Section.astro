---
// Consistent wrapper for page sections: eyebrow label, title, optional intro and a right-aligned action slot.
interface Props {
    id?: string;
    eyebrow?: string;
    title?: string;
    description?: string;
    class?: string;
}

const { id, eyebrow, title, description, class: className } = Astro.props;
const hasHeader = eyebrow || title || description || Astro.slots.has('action');
---

<section id={id} class:list={['container-page py-16 sm:py-24', className]}>
    {
        hasHeader && (
            <header class="mb-10 flex flex-wrap items-end justify-between gap-6 sm:mb-14" data-reveal>
                <div class="max-w-2xl">
                    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
                    {title && <h2 class="text-3xl sm:text-4xl">{title}</h2>}
                    {description && <p class="mt-4 text-lg text-muted">{description}</p>}
                </div>
                <slot name="action" />
            </header>
        )
    }
    <slot />
</section>
