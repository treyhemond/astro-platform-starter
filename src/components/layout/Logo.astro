---
import { site } from '../../config/site';

interface Props {
    /** Show the full name next to the monogram. */
    showName?: boolean;
}

const { showName = true } = Astro.props;
---

<span class="group inline-flex items-center gap-3">
    <span
        class="relative grid size-9 place-items-center overflow-hidden rounded-xl bg-gradient-to-br from-accent to-accent-2 font-mono text-sm font-bold text-accent-content shadow-[0_0_24px_-6px] shadow-accent/60 transition-transform duration-300 group-hover:rotate-[-6deg]"
        aria-hidden="true"
    >
        {site.initials}
    </span>
    {showName && <span class="font-semibold tracking-tight text-white">{site.name}</span>}
</span>
