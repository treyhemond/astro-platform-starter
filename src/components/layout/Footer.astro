---
import Logo from './Logo.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import { site } from '../../config/site';
import { resume } from '../../data/resume';

const year = new Date().getFullYear();
---

<footer class="relative mt-auto border-t border-line print:hidden">
    <div class="container-page flex flex-col gap-10 py-12 sm:py-14">
        <div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-start">
            <div class="max-w-sm">
                <a href="/" class="inline-block rounded-xl" aria-label={`${site.name} — home`}><Logo /></a>
                <p class="mt-4 text-sm leading-relaxed text-muted">
                    {resume.headline.join(' • ')}
                    <br />
                    Based in {resume.location.city}, {resume.location.region}.
                </p>
            </div>
            <div class="flex flex-col gap-6 sm:items-end">
                <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
                    {
                        site.nav.map((item) => (
                            <li>
                                <a href={item.href} class="text-muted transition-colors hover:text-fg">
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
                <SocialLinks />
            </div>
        </div>

        <div class="flex flex-col-reverse justify-between gap-4 border-t border-line pt-6 text-xs text-subtle sm:flex-row sm:items-center">
            <p>
                © {year}
                {site.name} · Built with <a href="https://astro.build" class="link text-muted">Astro</a> &amp; deployed on
                <a href="https://www.netlify.com" class="link text-muted">Netlify</a>
                {
                    site.sourceUrl && (
                        <>
                            · <a href={site.sourceUrl} class="link text-muted">Source</a>
                        </>
                    )
                }
            </p>
            <div class="flex items-center gap-4">
                <span class="font-mono">{site.version}</span>
                <!-- The only link to the semi-hidden After Hours section: deliberately faint. -->
                <a href={site.afterHours.href} title={site.afterHours.title} class="text-subtle/40 transition-colors hover:text-accent">
                    <Icon name="moon" class="size-3.5" label={site.afterHours.title} />
                </a>
                <a href="#top" class="group inline-flex items-center gap-1.5 text-muted transition-colors hover:text-fg">
                    Back to top
                    <Icon name="arrow-up" class="size-3.5 transition-transform group-hover:-translate-y-0.5" />
                </a>
            </div>
        </div>
    </div>
</footer>
